{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git switch -c feature/issue-*)",
      "Bash(git switch feature/issue-*)",
      "Bash(git switch main)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git merge-base *)",
      "Bash(git ls-files *)",
      "Bash(git add -N *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin feature/issue-*)",
      "Bash(git push origin feature/issue-*)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit *)",
      "Bash(npm install)",
      "Bash(npx vitest *)",
      "Bash(node --test *)",
      "Bash(openspec *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(node .claude/skills/*)",
      "Bash(mkdir -p .flujo/*)",
      "Edit(/.flujo/**)",
      "Skill(openspec-propose)",
      "Skill(openspec-apply-change)",
      "Skill(build-test)",
      "Skill(commit)",
      "Skill(abrir-pr)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh pr review * --request-changes*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Read(/.env)"
    ]
  }
}
