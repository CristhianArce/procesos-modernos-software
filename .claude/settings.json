{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git worktree add *)",
      "Bash(git worktree list *)",
      "Bash(git worktree remove .claude/worktrees/*)",
      "Bash(git worktree prune)",
      "Bash(git branch -D feature/issue-*)",
      "Bash(git branch -D chore/archivar-*)",
      "Bash(git switch -c feature/issue-*)",
      "Bash(git switch feature/issue-*)",
      "Bash(git switch main)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git merge-base *)",
      "Bash(git merge origin/*)",
      "Bash(git ls-files *)",
      "Bash(git add -N *)",
      "Bash(git add *)",
      "Bash(git mv db/migration/*)",
      "Bash(git commit -m *)",
      "Bash(git push -u origin feature/issue-*)",
      "Bash(git push -u origin chore/archivar-*)",
      "Bash(git push origin feature/issue-*)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npx playwright *)",
      "Bash(npx vitest *)",
      "Bash(node --test *)",
      "Bash(openspec *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr ready *)",
      "Bash(gh pr review * --comment *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh run view *)",
      "Bash(gh api *)",
      "Bash(docker compose *)",
      "Bash(docker buildx imagetools inspect *)",
      "Bash(node .claude/skills/*)",
      "Bash(mkdir -p .flujo/*)",
      "Bash(cp .env .claude/worktrees/*)",
      "Edit(/.flujo/**)",
      "Edit(/.claude/worktrees/**)",
      "Skill(openspec-propose)",
      "Skill(openspec-apply-change)",
      "Skill(build-test)",
      "Skill(commit)",
      "Skill(abrir-pr)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve*)",
      "Bash(gh pr review * --request-changes*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Edit(/.claude/worktrees/**/.github/**)",
      "Read(/.env)",
      "Read(/.claude/worktrees/**/.env)"
    ]
  }
}
