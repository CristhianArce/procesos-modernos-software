+export const dynamic = "force-dynamic";
+
+export default async function AcercaPage() {
+  const res = await fetch("http://localhost:3000/api/acerca", { cache: "no-store" });
+  const datos = await res.json();
+  return (
+    <main>
+      <h1>Acerca de</h1>
+      <p>{datos.texto}</p>
+      <p>Versión {datos.version}</p>
+    </main>
+  );
+}
